<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ tem sua própria API de splash screen (fundo + ícone),
         que ignora o launch_background.xml legado se não for configurada
         aqui — sem isso, alguns aparelhos (ex.: Samsung/One UI) caem num
         fundo escuro padrão em vez do azul-marinho da marca. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
