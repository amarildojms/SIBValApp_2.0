<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="SIBVal Connect"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTask (era singleTop): usuários relatavam o app aparecendo
             2-3 vezes na tela de apps recentes. singleTop só reaproveita a
             Activity se ela já estiver no topo da pilha da task atual — um
             toque em notificação (FCM/flutter_local_notifications) enquanto
             o app está em segundo plano chega via um PendingIntent que abre
             uma task nova, gerando um card duplicado nos recentes a cada
             notificação tocada assim. singleTask garante uma única
             instância em todo o sistema, roteando qualquer novo lançamento
             (notificação, ícone, etc.) para a instância existente via
             onNewIntent — o FlutterActivity/firebase_messaging já repassam
             onNewIntent normalmente, sem mudança de código nativo. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Requerida pelo image_cropper (biblioteca uCrop) — sem essa
             declaração explícita a tela de corte de foto não abre.
             Sem screenOrientation fixo (removido em 20/08/2026): a partir do
             Android 16 o sistema ignora restrições de orientação em telas
             grandes (dobráveis/tablets) e o Play Console passou a marcar
             isso como problema de compatibilidade — a MainActivity já não
             tinha nenhuma restrição, só esta tela de corte tinha. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:theme="@style/Ucrop.CropTheme"/>

        <!-- Canal/ícone usados pelo próprio SDK do FCM quando exibe a
             notificação com o app em segundo plano/finalizado (sem passar
             por PushNotificationService) — mesmo canal/ícone usados em
             primeiro plano via flutter_local_notifications. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default_channel"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>
    </application>
    <!-- Notificações push (FCM) — necessária a partir do Android 13
         (Tiramisu) para exibir notificação; solicitada em runtime via
         FirebaseMessaging.instance.requestPermission() em
         PushNotificationService. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sem isso, url_launcher (usado no link do local do evento, inscrição, parceiros,
             atualização da loja e envio de pedido de oração por WhatsApp) não encontra
             navegador/app pra abrir a URL no Android 11+ (regra de visibilidade de pacotes). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="http"/>
        </intent>
        <!-- Apps de banco/pagamento que a aba Contribua consegue detectar e
             abrir ao copiar uma chave PIX (01/09/2026) — ver lib/util/bank_apps.dart.
             Sem esta declaração, canResolveActivity()/launch() por nome de
             pacote falha silenciosamente no Android 11+ (regra de
             visibilidade de pacotes), mesmo com o app instalado. -->
        <package android:name="com.nu.production"/>
        <package android:name="com.itau"/>
        <package android:name="com.bradesco"/>
        <package android:name="br.com.bb.android"/>
        <package android:name="br.com.gabba.Caixa"/>
        <package android:name="com.santander.app"/>
        <package android:name="br.com.intermedium"/>
        <package android:name="com.c6bank.app"/>
        <package android:name="com.picpay"/>
        <package android:name="com.mercadopago.wallet"/>
        <package android:name="br.com.sicoobnet"/>
        <package android:name="br.com.sicredi.app"/>
    </queries>
</manifest>
